        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD;\n  A--&gt;B;\n  A--&gt;C;\n  B--&gt;D;\n  C--&gt;D;\nflowchart TB\n\n    %% TITLE\n    TITLE[\&quot;PROJECT 9 - END-TO-END SECURE AI APPLICATION&lt;br/&gt;THREAT MODEL\&quot;]\n\n    %% EXTERNAL ACTORS\n    subgraph EXT[\&quot;TRUST BOUNDARY 1 - EXTERNAL USERS\&quot;]\n        USER[\&quot;Legitimate User\&quot;]\n        ATTACKER[\&quot;Malicious User / Attacker\&quot;]\n    end\n\n    %% APPLICATION\n    subgraph APP[\&quot;TRUST BOUNDARY 2 - FLASK APPLICATION\&quot;]\n        API[\&quot;Flask REST API&lt;br/&gt;127.0.0.1:5000\&quot;]\n        JWT[\&quot;JWT Authentication&lt;br/&gt;PyJWT - HS256\&quot;]\n        INPUT[\&quot;Input Validation&lt;br/&gt;Length + Regex + Base64\&quot;]\n        HISTORY[\&quot;Conversation History&lt;br/&gt;Context Management\&quot;]\n        OUTPUT[\&quot;Output Scanner&lt;br/&gt;Prompt Leakage + Credential Detection&lt;br/&gt;URL Detection\&quot;]\n    end\n\n    %% AI SERVICE\n    subgraph AI[\&quot;TRUST BOUNDARY 3 - LOCAL AI SERVICE\&quot;]\n        OLLAMA[\&quot;Ollama API&lt;br/&gt;localhost:11434\&quot;]\n        MODEL[\&quot;Llama 3.2:1b&lt;br/&gt;Local Language Model\&quot;]\n    end\n\n    %% REJECTION PATHS\n    UNAUTH[\&quot;HTTP 401&lt;br/&gt;Unauthorized\&quot;]\n    BLOCKINPUT[\&quot;HTTP 400&lt;br/&gt;Malicious Input Blocked\&quot;]\n    BLOCKOUTPUT[\&quot;Response Blocked&lt;br/&gt;Unsafe Output\&quot;]\n    SAFE[\&quot;HTTP 200&lt;br/&gt;Approved AI Response\&quot;]\n\n    %% CI/CD\n    subgraph CICD[\&quot;TRUST BOUNDARY 4 - CI/CD SECURITY CONTROLS\&quot;]\n        REPO[\&quot;GitHub Source Repository\&quot;]\n        BANDIT[\&quot;Gate 1&lt;br/&gt;Bandit - SAST\&quot;]\n        AUDIT[\&quot;Gate 2&lt;br/&gt;pip-audit - CVE Scan\&quot;]\n        GITLEAKS[\&quot;Gate 3&lt;br/&gt;Gitleaks - Secret Detection\&quot;]\n        SCANNER[\&quot;Gate 4&lt;br/&gt;Custom AI Injection Scanner\&quot;]\n    end\n\n    %% USER REQUEST FLOW\n    TITLE --&gt; USER\n    TITLE --&gt; ATTACKER\n\n    USER --&gt;|\&quot;HTTP API Request\&quot;| API\n    ATTACKER --&gt;|\&quot;Unauthorized / Injection Request\&quot;| API\n\n    API --&gt; JWT\n    JWT --&gt;|\&quot;Invalid / Missing Token\&quot;| UNAUTH\n    JWT --&gt;|\&quot;Valid Token\&quot;| INPUT\n\n    INPUT --&gt;|\&quot;Malicious Input\&quot;| BLOCKINPUT\n    INPUT --&gt;|\&quot;Validated Input\&quot;| HISTORY\n\n    HISTORY --&gt;|\&quot;Validated Prompt + Context\&quot;| OLLAMA\n    OLLAMA --&gt; MODEL\n    MODEL --&gt;|\&quot;Generated Response\&quot;| OUTPUT\n\n    OUTPUT --&gt;|\&quot;Unsafe Response\&quot;| BLOCKOUTPUT\n    OUTPUT --&gt;|\&quot;Safe Response\&quot;| SAFE\n\n    %% RESPONSE PATH\n    SAFE --&gt; USER\n\n    %% CI/CD SCANNING\n    REPO --&gt; BANDIT\n    REPO --&gt; AUDIT\n    REPO --&gt; GITLEAKS\n    REPO --&gt; SCANNER\n\n    %% STYLING\n    classDef user fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A,stroke-width:2px\n    classDef attacker fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px\n    classDef security fill:#E0E7FF,stroke:#4F46E5,color:#312E81,stroke-width:2px\n    classDef ai fill:#D1FAE5,stroke:#059669,color:#064E3B,stroke-width:2px\n    classDef blocked fill:#FECACA,stroke:#DC2626,color:#7F1D1D\n    classDef success fill:#BBF7D0,stroke:#16A34A,color:#14532D\n    classDef cicd fill:#F1F5F9,stroke:#475569,color:#1E293B\n\n    class USER user\n    class ATTACKER attacker\n    class API,JWT,INPUT,OUTPUT,HISTORY security\n    class OLLAMA,MODEL ai\n    class UNAUTH,BLOCKINPUT,BLOCKOUTPUT blocked\n    class SAFE success\n    class REPO,BANDIT,AUDIT,GITLEAKS,SCANNER cicd\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EhoDANuvOIz7dYA51grR-1">
